# Copy to .env and fill in real values. Never commit the real .env file.

# ─── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
PUBLIC_URL=http://localhost:5000

# ─── Database (MySQL) ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=chatbot_saas
DB_CONNECTION_LIMIT=10
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0

# ─── Auth ───────────────────────────────────────────────────────
JWT_SECRET=
# Used to encrypt stored third-party credentials (Meta/TikTok app secrets, etc).
ENCRYPTION_KEY=

# ─── Meta (WhatsApp / Facebook / Instagram) — platform-level defaults;
# a Reseller/agency can override with its own app under Settings ────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# ─── Google (Google Sheets export integration) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── Stripe (billing) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── SMTP (Support Desk ticket notification emails) — platform-wide,
# one sender for every agency's helpdesk. Leave unset during local dev:
# notifications are logged instead of sent when these are blank. ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
