# Copy to .env and fill in real values. Never commit the real .env file.

# ─── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
PUBLIC_URL=http://localhost:5000

# ─── Database (MySQL) ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=chatbot_saas
DB_CONNECTION_LIMIT=10
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0

# ─── Auth ───────────────────────────────────────────────────────
JWT_SECRET=
# Signs the per-bot Telegram webhook secret, the inbound-flow webhook keys and
# the public booking-link keys (utils/webhookAuth.js, utils/publicBooking.js).
# Falls back to JWT_SECRET when empty — set it separately so rotating
# JWT_SECRET (signing everyone out) does not also break every shared booking
# link and Zapier/Make URL. Changing THIS value breaks those links too.
WEBHOOK_SECRET_KEY=
# Used to encrypt stored third-party credentials (Meta/TikTok app secrets, etc).
ENCRYPTION_KEY=

# ─── Meta (WhatsApp / Facebook / Instagram) — platform-level defaults;
# a Reseller/agency can override with its own app under Settings ────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# ─── Google (Google Sheets export integration) ─────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── Stripe (billing) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── SMTP — ONE platform-wide sender for every email the app sends:
# account email verification, Support Desk tickets, guest-checkout welcome. ───
# Leave blank during local dev: emails are logged instead of sent, and the
# verification link is printed in the server console so you can still click it.
# Verify your settings any time with:   npm run test:email -- you@example.com
#
# Pick ONE free provider (all speak plain SMTP — no code change needed):
#
#  Brevo (ex-Sendinblue) — 300 emails/day free. Best all-round free option.
#    SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#    SMTP_USER=<your Brevo login email>   SMTP_PASS=<an SMTP key from Brevo → SMTP & API>
#
#  Gmail — ~500 emails/day free, fine for early testing (needs 2-Step Verification
#  on, then an "App password"; your normal password will NOT work).
#    SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   (or 465)
#    SMTP_USER=you@gmail.com    SMTP_PASS=<16-char app password>
#
#  Resend — 3,000/month (100/day) free. Needs a verified domain to send to anyone.
#    SMTP_HOST=smtp.resend.com  SMTP_PORT=587
#    SMTP_USER=resend           SMTP_PASS=<API key>
#
#  Mailtrap (Email Sandbox) — DEV ONLY: catches every email in a fake inbox instead
#  of delivering it, so you can see exactly what users would receive.
#    SMTP_HOST=sandbox.smtp.mailtrap.io   SMTP_PORT=587
#    SMTP_USER=<from Mailtrap>            SMTP_PASS=<from Mailtrap>
#
# SMTP_FROM must be an address your provider has verified (a verified sender or a
# domain you own), e.g.  "Nexa AI Chat <no-reply@yourdomain.com>".
# For emails to land in the inbox (not spam) on a real domain, add the SPF + DKIM
# DNS records your provider gives you.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Broadcasting: audiences at or above this size get an extra "Large Audience" confirmation (default 5000)
# BROADCAST_LARGE_AUDIENCE_THRESHOLD=5000
