// Chatbot SaaS - Prisma Schema
// Multi-tenant: Admin -> Agencies -> Agents -> Contacts/Conversations

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  AGENCY
  AGENT
}

enum Platform {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TELEGRAM
  WEBCHAT
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  RESOLVED
  PENDING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
}

// ─────────────────────────────────────────────
//  USER (Shared auth table for all roles)
// ─────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(AGENT)
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // An AGENCY user owns one Agency record
  agency       Agency?  @relation("AgencyOwner")

  // An AGENT user belongs to an Agency
  agentProfile AgentProfile?

  @@map("users")
}

// ─────────────────────────────────────────────
//  AGENCY
// ─────────────────────────────────────────────

model Agency {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique   // e.g. "acme-corp"
  logo        String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The User who owns/manages this agency (role=AGENCY or ADMIN)
  ownerId     Int      @unique
  owner       User     @relation("AgencyOwner", fields: [ownerId], references: [id])

  // Parent agency — for sub-agencies created under an ADMIN owner.
  // NULL = top-level owner workspace. Non-null = Agency created under an ADMIN.
  parentAgencyId Int?
  parentAgency   Agency?  @relation("AgencyChildren", fields: [parentAgencyId], references: [id])
  childAgencies  Agency[] @relation("AgencyChildren")

  // Agents belonging to this agency
  agents      AgentProfile[]

  // Bot/channel integrations for this agency
  integrations Integration[]

  // Contacts (customers) for this agency
  contacts    Contact[]

  // Conversations for this agency
  conversations Conversation[]

  @@map("agencies")
}

// ─────────────────────────────────────────────
//  AGENT PROFILE (AGENT users linked to agency)
// ─────────────────────────────────────────────

model AgentProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId  Int
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  isOnline  Boolean  @default(false)
  // OWNER_USER = end-user created directly under the Owner/ADMIN
  // AGENCY_USER = end-user created under an Agency
  userType  String   @default("AGENCY_USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Conversations assigned to this agent
  conversations Conversation[]

  @@map("agent_profiles")
}

// ─────────────────────────────────────────────
//  INTEGRATION (WhatsApp / FB / IG per Agency)
// ─────────────────────────────────────────────

model Integration {
  id              Int      @id @default(autoincrement())
  agencyId        Int
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  platform        Platform
  name            String             // Friendly name e.g. "My WhatsApp Number"
  isActive        Boolean @default(true)

  // WhatsApp Business API (Meta Cloud API)
  waPhoneNumberId String?   // Phone Number ID from Meta
  waBusinessAccId String?   // WhatsApp Business Account ID
  accessToken     String?   @db.Text  // Meta Page / System User Access Token
  verifyToken     String?   // Webhook verify token (random secret you set)

  // Facebook Messenger
  fbPageId        String?
  fbPageName      String?

  // Instagram
  igAccountId     String?
  igUsername      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversations   Conversation[]

  @@unique([agencyId, platform, waPhoneNumberId])
  @@map("integrations")
}

// ─────────────────────────────────────────────
//  CONTACT (end-customers who message the bot)
// ─────────────────────────────────────────────

model Contact {
  id          Int      @id @default(autoincrement())
  agencyId    Int
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  platform    Platform
  externalId  String           // e.g. WhatsApp phone number / FB PSID / IG IGSID
  name        String?
  phone       String?
  email       String?
  avatar      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]

  @@unique([agencyId, platform, externalId])
  @@map("contacts")
}

// ─────────────────────────────────────────────
//  CONVERSATION
// ─────────────────────────────────────────────

model Conversation {
  id             Int                @id @default(autoincrement())
  agencyId       Int
  agency         Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactId      Int
  contact        Contact            @relation(fields: [contactId], references: [id])
  integrationId  Int
  integration    Integration        @relation(fields: [integrationId], references: [id])
  assignedToId   Int?
  assignedTo     AgentProfile?      @relation(fields: [assignedToId], references: [id])

  status         ConversationStatus @default(OPEN)
  unreadCount    Int                @default(0)
  lastMessageAt  DateTime?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  messages       Message[]

  @@map("conversations")
}

// ─────────────────────────────────────────────
//  MESSAGE
// ─────────────────────────────────────────────

model Message {
  id               Int              @id @default(autoincrement())
  conversationId   Int
  conversation     Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction        MessageDirection
  type             MessageType      @default(TEXT)
  body             String?          @db.Text
  mediaUrl         String?
  mediaCaption     String?

  // External message ID returned by Meta after sending/receiving
  externalMsgId   String?           @unique

  isRead           Boolean          @default(false)
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?

  createdAt        DateTime         @default(now())

  @@map("messages")
}

// ─────────────────────────────────────────────
//  QUICK REPLY TEMPLATE (Agency-level)
// ─────────────────────────────────────────────

model QuickReply {
  id         Int      @id @default(autoincrement())
  agencyId   Int
  title      String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("quick_replies")
}
