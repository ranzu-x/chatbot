# Copy to .env and fill in real values. Never commit the real .env file.

VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
# Extra Facebook Login permissions requested when connecting a Page (comma-separated).
# Default: pages_utility_messaging (Messenger Utility templates). Empty = none.
# VITE_FB_EXTRA_SCOPES=pages_utility_messaging
# Facebook JS SDK Graph version (default v26.0 — keep equal to the API META_API_VERSION)
# VITE_META_API_VERSION=v26.0
